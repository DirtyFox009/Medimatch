rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function authed() { return request.auth != null; }
    function isOwner(uid) { return authed() && request.auth.uid == uid; }

    // A doctor may read a patient's profile and records only while an unexpired
    // grant exists. Existence alone is not enough: it used to mean that a single
    // cancelled booking granted a doctor access forever. A grant carrying no
    // expiresAt is treated as expired, so anything unstamped fails closed.
    function grantActive(uid) {
      return authed()
        && exists(/databases/$(database)/documents/users/$(uid)/authorizedDoctors/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(uid)/authorizedDoctors/$(request.auth.uid))
             .data.get('expiresAt', request.time) > request.time;
    }

    // ── User profiles ────────────────────────────────────────────────────
    match /users/{uid} {
      // The owner reads their own profile; a doctor the patient has booked may
      // also read it (the Rx screen prefills the patient's name). Authorized by
      // the same grant doc as records — never a blanket doctor-role read, which
      // would expose every user profile to every doctor account.
      allow read: if isOwner(uid) || grantActive(uid);
      // Self-signup may only create a patient profile; doctor accounts are
      // provisioned by the admin script (scripts/provisionDoctorAccounts.ts).
      allow create: if isOwner(uid)
        && request.resource.data.role == 'patient'
        && request.resource.data.uid == uid;
      // Role and doctor linkage can never be self-modified.
      allow update: if isOwner(uid)
        && request.resource.data.get('role', 'patient') == resource.data.get('role', 'patient')
        && request.resource.data.get('doctorId', null) == resource.data.get('doctorId', null);
      allow delete: if false;

      match /records/{recordId} {
        // The owner reads/writes freely; a doctor the patient has booked may
        // READ (never write) — authorized by the grant doc below, since rules
        // can only get/exists a known path, not query the appointments list.
        allow read: if isOwner(uid) || grantActive(uid);
        allow write: if isOwner(uid);
      }
      // Read-grant ledger: one doc per doctor the patient has booked. Written by
      // the patient (owner) at booking time; the named doctor may read it.
      match /authorizedDoctors/{doctorUid} {
        allow read: if isOwner(uid) || request.auth.uid == doctorUid;
        // Only the patient may grant or extend access. Deliberately NOT requiring
        // expiresAt here: this write happens inside the booking transaction, so
        // rejecting an unstamped grant would fail the whole booking for any client
        // running code older than the expiry change. A grant without a usable
        // expiresAt is already powerless — grantActive() above denies it — so the
        // read rule is what enforces this, and it fails closed on its own.
        allow create, update: if isOwner(uid);
        // Either side may revoke. A doctor cancelling an appointment has no write
        // access here, and must not — that would let them extend their own window
        // — but dropping their own access is always safe.
        allow delete: if isOwner(uid) || request.auth.uid == doctorUid;
      }
      match /medicines/{medicineId} {
        allow read, write: if isOwner(uid);
      }
    }

    // ── Doctors (seeded via admin SDK) ───────────────────────────────────
    match /doctors/{doctorId} {
      allow read: if authed();
      // A doctor may edit their own profile's practice details. Identity and
      // trust fields (name, specialty, bmdcReg, isVerified, ratings) remain
      // operator-only via the seed/provision scripts.
      allow update: if authed()
        && resource.data.get('userId', '') == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['isAvailable', 'qualifications', 'hospitalNameEn',
                       'hospitalNameBn', 'consultationFee', 'telemedicineFee',
                       'telemedicineAvailable', 'availableDays', 'timeSlots',
                       'bio', 'updatedAt',
                       // Chamber capacity: how many patients a day, over what
                       // hours, and whether bookings auto-confirm.
                       'autoConfirm', 'chamberStart', 'slotDurationMins',
                       'dailyPatientLimit', 'dailyLimitOverrides'])
        && request.resource.data.consultationFee is number
        && request.resource.data.consultationFee >= 0
        && request.resource.data.telemedicineFee is number
        && request.resource.data.telemedicineFee >= 0
        // Defaults keep these valid for the seeded docs that predate the fields.
        && request.resource.data.get('autoConfirm', true) is bool
        && request.resource.data.get('chamberStart', '09:00') is string
        && request.resource.data.get('chamberStart', '09:00').size() == 5
        && request.resource.data.get('slotDurationMins', 30) is int
        && request.resource.data.get('slotDurationMins', 30) >= 5
        && request.resource.data.get('slotDurationMins', 30) <= 120
        && request.resource.data.get('dailyPatientLimit', 1) is int
        && request.resource.data.get('dailyPatientLimit', 1) >= 0
        && request.resource.data.get('dailyPatientLimit', 1) <= 100
        && request.resource.data.get('dailyLimitOverrides', {}) is map
        && request.resource.data.get('dailyLimitOverrides', {}).size() <= 60
        && request.resource.data.timeSlots.size() <= 100;
      // Rating aggregation: any authed user may advance the rating fields by
      // exactly one review. Runs in the same transaction as the review create
      // below, whose rule enforces the completed-appointment requirement.
      allow update: if authed()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['ratingAvg', 'reviewCount', 'updatedAt'])
        && request.resource.data.reviewCount == resource.data.reviewCount + 1
        && request.resource.data.ratingAvg >= 0
        && request.resource.data.ratingAvg <= 5;
      allow create, delete: if false;

      // Public booking ledger — opaque slot occupancy, no health data.
      match /slots/{slotId} {
        allow read: if authed();
        allow create: if authed()
          && request.resource.data.bookedBy == request.auth.uid
          && request.resource.data.keys().hasAll(['date', 'timeSlot', 'bookedBy', 'appointmentId']);
        // Freed on cancellation by the patient who booked it, or by the
        // doctor who owns this doctor profile.
        allow delete: if authed()
          && (resource.data.bookedBy == request.auth.uid
              || get(/databases/$(database)/documents/doctors/$(doctorId)).data.get('userId', '') == request.auth.uid);
        allow update: if false;
      }

      // Review id == appointmentId → exactly one review per appointment,
      // and only for a completed appointment with this doctor.
      match /reviews/{appointmentId} {
        allow read: if authed();
        allow create: if authed()
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.rating is int
          && request.resource.data.rating >= 1
          && request.resource.data.rating <= 5
          && request.resource.data.comment is string
          && request.resource.data.comment.size() <= 1000
          && get(/databases/$(database)/documents/appointments/$(appointmentId)).data.patientId == request.auth.uid
          && get(/databases/$(database)/documents/appointments/$(appointmentId)).data.doctorId == doctorId
          && get(/databases/$(database)/documents/appointments/$(appointmentId)).data.status == 'completed';
        allow update, delete: if false;
      }
    }

    // ── Appointments ─────────────────────────────────────────────────────
    match /appointments/{appointmentId} {
      allow read: if authed()
        && (resource.data.patientId == request.auth.uid
            || resource.data.get('doctorUserId', '') == request.auth.uid);
      allow create: if authed()
        && request.resource.data.patientId == request.auth.uid
        && request.resource.data.status in ['pending', 'confirmed']
        && request.resource.data.keys().hasAll(
             ['patientId', 'doctorId', 'date', 'timeSlot', 'type', 'fee', 'status'])
        && request.resource.data.type in ['in-person', 'telemedicine'];
      // Patient may only cancel; doctor may confirm/complete/cancel.
      allow update: if authed()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'updatedAt', 'notes', 'statusChangedBy'])
        // statusChangedBy drives the notification feed's "was this me?" check,
        // so it may only ever name the caller — otherwise either party could
        // forge it and suppress the other's notification.
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['statusChangedBy'])
            || request.resource.data.statusChangedBy == request.auth.uid)
        && (
          (resource.data.patientId == request.auth.uid
             && request.resource.data.status == 'cancelled')
          || (resource.data.get('doctorUserId', '') == request.auth.uid
             && request.resource.data.status in ['confirmed', 'completed', 'cancelled'])
        );
      allow delete: if false;
    }

    // ── Prescriptions ────────────────────────────────────────────────────
    // Doc id == appointmentId → exactly one prescription per appointment.
    // Immutable once written: a prescription is a medical document of record.
    match /prescriptions/{appointmentId} {
      allow read: if authed()
        && (resource.data.patientId == request.auth.uid
            || resource.data.doctorUserId == request.auth.uid);
      // Only the doctor who owns the appointment may issue its prescription,
      // and the patientId must match the appointment's real patient.
      allow create: if authed()
        && request.resource.data.doctorUserId == request.auth.uid
        && get(/databases/$(database)/documents/doctors/$(request.resource.data.doctorId)).data.get('userId', '') == request.auth.uid
        && get(/databases/$(database)/documents/appointments/$(appointmentId)).data.get('doctorUserId', '') == request.auth.uid
        && request.resource.data.patientId
             == get(/databases/$(database)/documents/appointments/$(appointmentId)).data.patientId
        && request.resource.data.appointmentId == appointmentId
        && request.resource.data.keys().hasAll(
             ['appointmentId', 'patientId', 'doctorId', 'doctorUserId',
              'patientName', 'diagnosis', 'items', 'date'])
        && request.resource.data.items is list
        && request.resource.data.items.size() >= 1
        && request.resource.data.items.size() <= 20
        && request.resource.data.patientName is string
        && request.resource.data.patientName.size() > 0
        && request.resource.data.patientName.size() <= 200
        && request.resource.data.diagnosis is string
        && request.resource.data.diagnosis.size() <= 2000;
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
